SECRET_KEY=change-this-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
COMPANY_UPI_ID=company@upi
COMPANY_NAME=Final Mile Techies
FLASK_DEBUG=False

# Session: idle sessions expire after this many hours
SESSION_LIFETIME_HOURS=8
# Set True once served over HTTPS (must stay False for local HTTP dev)
SESSION_COOKIE_SECURE=False

# Login lockout: block an identity+IP after N failed attempts within the
# window, for the given lockout duration
LOGIN_MAX_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW_MINUTES=10
LOGIN_LOCKOUT_MINUTES=15

# Outbound mail for expense-approval notifications. Leave SMTP_HOST blank
# to skip sending (the approval workflow still works, it just won't email).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=True
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Final Mile Techies Expense Tracker

# Optional: guarantees this admin account exists every time the app boots
# (email+password login, full super-admin access). Leave blank to skip --
# local dev can already log in via ADMIN_USERNAME/ADMIN_PASSWORD above.
# This matters specifically on platforms without a persistent database
# (e.g. Vercel, see README's Deploying to Vercel section) where nothing
# else survives between cold starts.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_PASSWORD=
